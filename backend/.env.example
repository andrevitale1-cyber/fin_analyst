# Configure estas variáveis no ambiente do servidor. Não coloque chaves no frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Seleção automática por tarefa; OPENAI_MODEL permanece para buscas e rascunhos do X.
OPENAI_ANALYSIS_MODEL=gpt-6-luna
OPENAI_FULL_REPORT_MODEL=gpt-6.1-sol
PLATFORM_URL=https://finanalyser.com.br
# Opcional: sem Tavily, a busca usa a pesquisa web da OpenAI.
TAVILY_API_KEY=
# Verificação das sessões para a biblioteca de relatórios completos.
CLERK_ISSUER=https://clerk.finanalyser.com.br
CLERK_AUTHORIZED_PARTIES=https://finanalyser.com.br,https://www.finanalyser.com.br
