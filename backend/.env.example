# Configure estas variáveis no ambiente do servidor. Não coloque chaves no frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Seleção automática por tarefa; OPENAI_MODEL permanece para buscas e rascunhos do X.
OPENAI_ANALYSIS_MODEL=gpt-6-luna
OPENAI_FULL_REPORT_MODEL=gpt-6.1-sol
PLATFORM_URL=https://finanalyser.com.br
# Opcional: sem Tavily, a busca usa a pesquisa web da OpenAI.
TAVILY_API_KEY=
# Verificação das sessões para a biblioteca de relatórios completos.
CLERK_ISSUER=https://clerk.finanalyser.com.br
CLERK_AUTHORIZED_PARTIES=https://finanalyser.com.br,https://www.finanalyser.com.br

# Opcional: localiza releases oficiais antes da busca RI/SEC/web; nunca vai ao frontend.
EQUIBLES_API_KEY=
# Opcional: histórico consolidado dos EUA como alternativa para Market reaction.
# Market Data somente; não são feitas chamadas de ordens/negociação. Mantenha desativado até validar acesso e licença.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_MARKET_DATA_ENABLED=0

# TikTok Events API: segredos somente no servidor.
TIKTOK_EVENTS_API_TOKEN=
TIKTOK_PIXEL_ID=DBT8JPJC77UEEP3E4PS0
STRIPE_TIKTOK_WEBHOOK_SECRET=
